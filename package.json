{
  "name": "securia360",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @securia360/web",
    "build": "npm run build --workspace @securia360/web",
    "lint": "npm run lint --workspace @securia360/web",
    "test": "npm run test --workspace @securia360/web",
    "test:integration": "npm run test:integration --workspace @securia360/web",
    "test:e2e": "npm run test:e2e --workspace @securia360/web",
    "test:e2e:ui": "npm run test:e2e:ui --workspace @securia360/web",
    "typecheck": "npm run typecheck --workspace @securia360/web"
  },
  "devDependencies": {
    "jsdom": "29.0.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
